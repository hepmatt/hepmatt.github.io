rules_version = '2';

// Firestore rules for MarioPartyTracker.html
// Paste into Firebase console > Firestore Database > Rules, then Publish.
//
// Anyone with the link can read, add, and delete games (by design).
// Edits are blocked, and new docs must look like a real game, so the
// database cannot be filled with junk fields or giant documents.
service cloud.firestore {
  match /databases/{database}/documents {

    function validPlayers(ps) {
      return ps is list && ps.size() >= 2 && ps.size() <= 8;
    }

    match /games/{gameId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['date', 'board', 'mode', 'turns', 'players', 'hasPhoto', 'createdAt'])
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.board is string
                    && request.resource.data.board.size() > 0
                    && request.resource.data.board.size() <= 60
                    && request.resource.data.mode is string
                    && request.resource.data.mode.size() <= 30
                    && request.resource.data.turns is int
                    && request.resource.data.hasPhoto is bool
                    && request.resource.data.createdAt == request.time
                    && validPlayers(request.resource.data.players);
      allow update: if false;
      allow delete: if true;
    }

    match /photos/{gameId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['data'])
                    && request.resource.data.data is string
                    && request.resource.data.data.matches('^data:image/jpeg;base64,.*')
                    && request.resource.data.data.size() < 900000;
      allow update: if false;
      allow delete: if true;
    }
  }
}
